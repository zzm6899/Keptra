diff --git a/web/assets/keptra-cull.css b/web/assets/keptra-cull.css
new file mode 100644
index 0000000..ff5c14b
--- /dev/null
+++ b/web/assets/keptra-cull.css
@@ -0,0 +1,138 @@
+.cull-hero {
+  --cull-ink: #f5f4ed;
+  --cull-muted: #b0c0b8;
+  --cull-accent: #a9e1c1;
+  --cull-rule: #394940;
+  color: var(--cull-ink);
+  background: radial-gradient(ellipse at 75% 24%, #273e32, #141e1a 62%);
+  padding-block: clamp(36px, 4vw, 62px);
+}
+
+.cull-hero-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.25fr);
+  align-items: center;
+  gap: clamp(28px, 4vw, 60px);
+  min-height: calc(100svh - 88px - clamp(72px, 8vw, 124px));
+  animation: cull-arrive 600ms cubic-bezier(.21,.63,.36,1) both;
+}
+
+.site-header nav { width: min(1200px, calc(100% - 80px)); }
+.site-header .nav-menu-toggle { width: 44px; height: 44px; }
+.nav-logo, .site-header .nav-cta { min-height: 44px; }
+
+@keyframes cull-arrive {
+  from { opacity: 0; transform: translateY(12px); }
+}
+
+.cull-platform { color: var(--cull-accent); font-size: 13px; font-weight: 650; }
+.cull-intro h1 { font-size: clamp(46px, 5.5vw, 82px); margin: 18px 0 24px; }
+.cull-intro h1 em { color: var(--cull-accent); }
+.cull-intro > p:not(.cull-platform) { max-width: 32ch; color: var(--cull-muted); font-size: clamp(15px, 1.32vw, 19px); }
+.cull-intro .btn-primary { color: #14261d; background: var(--cull-accent); border-color: var(--cull-accent); }
+.cull-intro .btn-primary:hover { background: #d3f3df; }
+.cull-intro .text-link { display: inline-flex; align-items: center; min-height: 44px; border-color: var(--cull-muted); }
+.cull-intro .text-link:hover { color: var(--cull-accent); border-color: currentColor; }
+.cull-intro .text-link span { font-size: inherit; margin: 0 0 0 4px; }
+.video-frame:focus-within { outline: 3px solid #f4bd7f; outline-offset: 3px; }
+
+.cull-workspace {
+  min-width: 0;
+  background: #161f1b;
+  border: 1px solid #526459;
+  border-radius: 12px;
+  box-shadow: 0 24px 70px #05090766;
+  scroll-margin-top: 16px;
+}
+
