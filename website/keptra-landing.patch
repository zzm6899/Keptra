diff --git a/web/assets/keptra-cull.js b/web/assets/keptra-cull.js
new file mode 100644
index 0000000..efcf7ad
--- /dev/null
+++ b/web/assets/keptra-cull.js
@@ -0,0 +1,88 @@
+(() => {
+  const demo = document.getElementById('cull-demo');
+  const image = document.getElementById('cull-image');
+  const filename = document.getElementById('cull-filename');
+  const position = document.getElementById('cull-position');
+  const status = document.getElementById('cull-frame-status');
+  const count = document.getElementById('cull-count');
+  const pick = document.getElementById('cull-pick');
+  const reject = document.getElementById('cull-reject');
+  const rating = document.getElementById('cull-rating');
+  const preview = document.getElementById('cull-preview');
+  const plan = document.getElementById('cull-plan');
+  const files = document.getElementById('cull-plan-files');
+  const reset = document.getElementById('cull-reset');
+  const frames = [...demo.querySelectorAll('.cull-filmstrip button')].map(button => ({
+    button, decision: '', rating: 0,
+  }));
+  let current = 0;
+
+  function render() {
+    const frame = frames[current];
+    const pickedCount = frames.filter(item => item.decision === 'Picked').length;
+    image.dataset.frame = frame.button.dataset.frame;
+    image.setAttribute('aria-label', frame.button.dataset.description);
+    filename.textContent = frame.button.dataset.filename;
+    position.textContent = `${current + 1} of ${frames.length}`;
+    status.textContent = `${frame.decision || 'Unreviewed'}${frame.rating ? ` · ${frame.rating} ${frame.rating === 1 ? 'star' : 'stars'}` : ''}`;
+    pick.setAttribute('aria-pressed', String(frame.decision === 'Picked'));
+    reject.setAttribute('aria-pressed', String(frame.decision === 'Rejected'));
+    rating.value = String(frame.rating);
+    count.textContent = `${pickedCount} of ${frames.length} picked`;
+    preview.disabled = pickedCount === 0;
+    reset.disabled = current === 0 && frames.every(item => !item.decision && !item.rating);
+    frames.forEach((item, index) => {
+      item.button.setAttribute('aria-pressed', String(index === current));
+      item.button.setAttribute('aria-label', `${item.button.dataset.filename}, ${item.decision || 'unreviewed'}`);
+      item.button.querySelector('.cull-frame-mark').textContent = { Picked: '✓', Rejected: '×' }[item.decision] || '';
+    });
+  }
+
+  function decide(decision) {
+    const frame = frames[current];
+    frame.decision = frame.decision === decision ? '' : decision;
+    render();
+  }
+
+  frames.forEach((frame, index) => frame.button.addEventListener('click', () => {
+    current = index;
+    render();
+  }));
+  pick.addEventListener('click', () => decide('Picked'));
+  reject.addEventListener('click', () => decide('Rejected'));
+  rating.addEventListener('change', () => {
+    frames[current].rating = Number(rating.value);
+    render();
+  });
+  reset.addEventListener('click', () => {
+    current = 0;
+    frames.forEach(frame => { frame.decision = ''; frame.rating = 0; });
+    demo.focus({ preventScroll: true });
+    render();
+  });
+  preview.addEventListener('click', () => {
+    files.replaceChildren(...frames.filter(frame => frame.decision === 'Picked').map(frame => {
+      const item = document.createElement('li');
+      item.textContent = frame.button.dataset.filename;
+      return item;
+    }));
+    plan.showModal();
+  });
+  demo.addEventListener('keydown', event => {
+    if (plan.open || event.target === rating || event.repeat || event.altKey || event.ctrlKey || event.metaKey) return;
+    const key = event.key.toLowerCase();
+    if (key === 'p') decide('Picked');
+    else if (key === 'x') decide('Rejected');
+    else if (/^[0-5]$/.test(key)) {
+      frames[current].rating = Number(key);
+      render();
+    } else if (key === 'arrowleft' || key === 'arrowright') {
+      current = (current + (key === 'arrowright' ? 1 : -1) + frames.length) % frames.length;
+      render();
+    } else return;
+    event.preventDefault();
+  });
+
+  document.getElementById('cull-controls').disabled = false;
+  render();
+})();
